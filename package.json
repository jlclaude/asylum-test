{
  "name": "asylum-test",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run start",
    "setup": "npm run setup:local",
    "setup:local": "npm run db:local:generate && npm run db:local:migrate:deploy",
    "setup:production": "npm run db:production:generate && npm run db:production:migrate:deploy",
    "prisma:verify-schemas": "node scripts/verify-prisma-schema-parity.mjs",
    "db:local:generate": "npm run prisma:verify-schemas && prisma generate --config prisma.local.config.ts",
    "db:local:migrate:dev": "prisma migrate dev --config prisma.local.config.ts",
    "db:local:migrate:deploy": "prisma migrate deploy --config prisma.local.config.ts",
    "db:production:generate": "node scripts/verify-production-database-url.mjs && npm run prisma:verify-schemas && prisma generate",
    "db:production:migrate:deploy": "node scripts/verify-production-database-url.mjs && npm run prisma:verify-schemas && prisma migrate deploy",
    "prisma:generate": "npm run db:production:generate",
    "db:migrate:deploy": "npm run db:production:migrate:deploy",
    "db:status": "node scripts/verify-production-database-url.mjs && prisma migrate status",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "desktop:dev": "npm run dev --workspace @asylum-games/desktop",
    "desktop:typecheck": "npm run typecheck --workspace @asylum-games/desktop",
    "desktop:build": "npm run build --workspace @asylum-games/desktop",
    "desktop:package:mac": "npm run package:mac --workspace @asylum-games/desktop"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "argon2": "^0.44.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^1.2.0",
    "@shopify/polaris-types": "^1.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "workspaces": [
    "desktop",
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "johnclaude"
}
